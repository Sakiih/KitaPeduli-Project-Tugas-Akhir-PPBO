            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"budi@kitapeduli.test\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/login"
          }
        },
        {
          "name": "1.4 Profil Akun Aktif (GET /api/me)",
          "request": {
            "method": "GET",
            "header": [
